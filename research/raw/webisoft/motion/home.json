  "keyframes": {
    "blink-animation": [
      "50% {visibility: hidden;}"
    ],
    "blink-once-animation": [
      "0% {opacity: 1;}",
      "40% {opacity: 0;}",
      "60% {opacity: 1;}",
      "80% {opacity: 0;}",
      "100% {opacity: 1;}"
    ],
    "DropdownContentUpShow": [
      "0% {opacity: 0; transform: translateY(-1em);}",
      "100% {opacity: 1; transform: translateY(0px);}"
    ],
    "DropdownContentUpHide": [
      "0% {opacity: 1; transform: translateY(0px);}",
      "100% {opacity: 0; transform: translateY(-1em);}"
    ],
    "DropdownContentBottomShow": [
      "0% {opacity: 0; transform: translateY(1em);}",
      "100% {opacity: 1; transform: translateY(0px);}"
    ],
    "DropdownContentBottomHide": [
      "0% {opacity: 1; transform: translateY(0px);}",
      "100% {opacity: 0; transform: translateY(1em);}"
    ],
    "swiper-preloader-spin": [
      "0% {transform: rotate(0deg);}",
      "100% {transform: rotate(360deg);}"
    ]
  },
  "cssTransitionDurations": [
    [
      "0.3s",
      2
    ],
    [
      "1ms",
      1
    ]
  ],
