    "DropdownContentBottomShow": [
      "0% {opacity: 0; transform: translateY(1em);}",
      "100% {opacity: 1; transform: translateY(0px);}"
    ],
    "DropdownContentBottomHide": [
      "0% {opacity: 1; transform: translateY(0px);}",
      "100% {opacity: 0; transform: translateY(1em);}"
    ]
  },
