  "counts": {
    "canvas": 0,
    "video": 0,
    "autoplayVideo": 0,
    "svgAnimate": 0,
    "webglCanvases": 0
  },
  "reducedMotionRules": [
    "(prefers-reduced-motion: reduce) → #intro-door { display: none; } #root { animation: auto ease 0s 1 normal none running none; }",
    "(prefers-reduced-motion: no-preference) → .page-enter { animation: 0.45s cubic-bezier(0.23, 1, 0.32, 1) 0s 1 normal both running page-enter; } .line-mask > span { display: block; animation: 1s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running line-up; } .fade-late { animation: 0.8s ease-out 0s 1 normal both running fade-late; }",
    "(prefers-reduced-motion: no-preference) → .product-play { animation: 11s cubic-bezier(0.45, 0, 0.3, 1) 0.6s infinite alternate both running product-play; }",
    "(prefers-reduced-motion: reduce) → .rise > .rise-inner { transform: none; transition: none; }",
    "(prefers-reduced-motion: reduce) → .roll-a, .roll-b { transition: none; }",
    "(prefers-reduced-motion: reduce) → .motion-reduce\\:relative { position: relative; }"
  ],
  "reducedMotionInJS": false,
  "keyframes": {
    "intro-door-in": [
      "100% {transform: translate3d(0px, -30vh, 0px);}"
    ],
    "intro-letter": [
      "100% {transform: none;}"
    ],
    "intro-dot": [
      "30% {opacity: 1;}",
      "100% {opacity: 1; transform: none;}"
    ],
    "intro-door-give-up": [
      "100% {visibility: hidden;}"
    ],
    "intro-root": [
      "0% {visibility: hidden;}",
      "100% {visibility: visible;}"
    ],
    "page-enter": [
      "0% {opacity: 0;}"
    ],
    "line-up": [
      "0% {transform: translateY(125%);}"
    ],
    "fade-late": [
      "0% {opacity: 0;}"
    ],
    "intro-settle": [
      "0% {transform: scale(1.08) translateY(4vh);}"
    ],
    "product-play": [
      "100% {transform: translateY(calc(-100% + 100cqh));}"
    ]
  },
