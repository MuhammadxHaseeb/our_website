{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "dev", "--", "--port", "3000"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "start", "--", "--port", "3100"],
      "port": 3100,
      "url": "http://localhost:3100"
    },
    {
      "name": "brand-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5180", "--directory", "docs"],
      "port": 5180,
      "url": "http://localhost:5180"
    }
  ]
}
